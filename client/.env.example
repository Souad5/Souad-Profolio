# Client environment (copy this file to .env and fill in real values)
# Local dev: http://localhost:5000/api. Production (Netlify env vars): the
# deployed API, e.g. https://server-gilt-delta-36.vercel.app/api — production
# builds refuse local/LAN URLs (they'd trigger Chrome's Local Network Access
# prompt for every visitor).
VITE_API_URL=http://localhost:5000/api
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=