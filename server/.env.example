# Server environment (copy this file to .env and fill in real values)
DATABASE_URL="postgresql://portfolio:portfolio_dev_password@localhost:5432/portfolio_db?schema=public"
PORT=5000
CLIENT_URL="http://localhost:5173"
# Required in production: a random string of 32+ characters. Placeholders and
# short values are rejected there (admin login is disabled until it's fixed).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Admin session length; the panel logs out automatically when it expires.
JWT_EXPIRES_IN="1d"
ADMIN_EMAIL="admin@portfolio.com"
ADMIN_PASSWORD="change-me-admin-password"