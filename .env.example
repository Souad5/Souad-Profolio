# ===========================================================================
# SERVER (copy to server/.env)
# ===========================================================================

# PostgreSQL connection string (Prisma). User + DB must be created first, e.g.:
#   sudo -u postgres psql \
#     -c "CREATE USER portfolio WITH PASSWORD 'portfolio_dev_password';" \
#     -c "CREATE DATABASE portfolio_db OWNER portfolio;"
DATABASE_URL="postgresql://portfolio:portfolio_dev_password@localhost:5432/portfolio_db?schema=public"

# Server port
PORT=5000

# Allowed CORS origin(s) for the client dev server
CLIENT_URL="http://localhost:5173"

# JWT secret for signing auth tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Initial admin credentials. The seed script creates this admin with a hashed
# password. Change before deploying. NEVER commit real values.
ADMIN_EMAIL="admin@portfolio.com"
ADMIN_PASSWORD="admin12345"

# ===========================================================================
# CLIENT (copy to client/.env)
# ===========================================================================

# Base URL of the backend API (used by the data layer)
VITE_API_URL="http://localhost:5000/api"

# EmailJS (client-side contact delivery). Public keys only.
VITE_EMAILJS_SERVICE_ID="service_m6bjubn"
VITE_EMAILJS_TEMPLATE_ID="template_qj9mjd7"
VITE_EMAILJS_PUBLIC_KEY="J0TRHxf-yyTfkDs8W"
